# ANYFORM configuration. Copy to .env.local (development) or provide via your
# deployment's secret manager. Every variable is optional in development.

# --- Core ---------------------------------------------------------------------
# Where uploads, outputs, metadata (local mode) and scratch files live.
ANYFORM_DATA_DIR=./data
# HMAC key for session cookies. REQUIRED in production (32+ random characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Public origin, e.g. https://anyform.example.com. When set, state-changing
# requests must originate from it (CSRF defence behind proxies).
PUBLIC_ORIGIN=
# Only enable behind a trusted reverse proxy that sets X-Forwarded-*.
TRUST_PROXY=false

# --- Queue / metadata ---------------------------------------------------------
# Unset: local mode (single process, in-process queue, file metadata).
# Set:   BullMQ queue + Redis metadata; run `npm run worker` separately.
REDIS_URL=

# --- Media tools --------------------------------------------------------------
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_THREADS=2

# --- Limits -------------------------------------------------------------------
MAX_UPLOAD_MB=500
MAX_DURATION_SECONDS=14400
MAX_VIDEO_DURATION_SECONDS=7200
# Images above this many pixels (width × height) are refused before decoding.
MAX_IMAGE_PIXELS=100000000
MAX_PDF_PAGES=1000
MAX_RENDER_PAGES=100
MAX_ARCHIVE_ENTRIES=10000
# Total uncompressed size allowed inside an archive (zip-bomb protection).
MAX_ARCHIVE_UNPACKED_MB=4096
# Heap cap for the sandbox process that parses images, PDFs and archives.
SANDBOX_MEMORY_MB=1024
SESSION_QUOTA_MB=2048
SESSION_MAX_ACTIVE_JOBS=3
MIN_FREE_DISK_MB=1024
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=7200
PROBE_TIMEOUT_SECONDS=30
JOB_MAX_ATTEMPTS=2
RATE_LIMIT_UPLOADS_PER_HOUR=30
RATE_LIMIT_REQUESTS_PER_MINUTE=240

# --- URL import -----------------------------------------------------------------
IMPORT_ENABLED=true
IMPORT_TIMEOUT_SECONDS=120
IMPORT_MAX_REDIRECTS=5
# Optional allowlist of hosts/parent domains (comma separated). Empty = any public host.
IMPORT_ALLOWED_HOSTS=
# Never enable in production (the server refuses to start). For tests/local dev only.
IMPORT_ALLOW_PRIVATE_NETWORKS=false

# --- Retention ----------------------------------------------------------------
UPLOAD_TTL_MINUTES=60
RESULT_TTL_MINUTES=60
METADATA_RETENTION_HOURS=24
CLEANUP_INTERVAL_SECONDS=60

# --- Observability ------------------------------------------------------------
LOG_LEVEL=info
# Enables GET /api/v1/metrics with "Authorization: Bearer <token>" (16+ chars).
METRICS_TOKEN=
